 package api
 
 import (
+	"fmt"
 	"io"
 	"log"
 	"os"
+	"path/filepath"
+	"strconv"
 	"strings"
 
 	"inventoryd/internal/report"
@@ -45,6 +48,78 @@
 	needle := strings.ToLower(q)
 	for _, it := range s.St.List() {
 		if needle == "" || strings.Contains(strings.ToLower(it.Name), needle) {
+			out = append(out, it)
+		}
+	}
+	return out, nil
+}
+
+// Page is a pagination window for the query APIs.
+type Page struct {
+	Limit  int
+	Offset int
+}
+
+// MaxPageLimit caps page sizes; requests above it are rejected.
+const MaxPageLimit = 500
+
+// QueryItemsPage lists items matching q (see QueryItems) inside the
+// page window. Limit MUST be in 1..MaxPageLimit — 0 and negatives are
+// rejected. Offset < 0 is clamped to 0 (documented leniency).
+func (s *Service) QueryItemsPage(q string, p Page) ([]store.Item, error) {
+	if p.Limit < 1 || p.Limit > MaxPageLimit {
+		return nil, fmt.Errorf("api: limit %d out of range 1..%d", p.Limit, MaxPageLimit)
+	}
+	if p.Offset < 0 {
+		p.Offset = 0
+	}
+	all, err := s.QueryItems(q)
+	if err != nil {
+		return nil, err
+	}
+	if p.Offset >= len(all) {
+		return []store.Item{}, nil
+	}
+	end := p.Offset + p.Limit
+	if end > len(all) {
+		end = len(all)
+	}
+	return all[p.Offset:end], nil
+}
+
+// ExportOwnerCSV writes the owner's stock view as CSV to dir/filename.
+// Owner exports are small and streamed straight to disk, so they keep
+// a dedicated fast path instead of the report pipeline.
+func (s *Service) ExportOwnerCSV(dir, filename, email string) (string, error) {
+	items, err := s.QueryByOwner(email)
+	if err != nil {
+		return "", err
+	}
+	if err := os.MkdirAll(dir, 0o755); err != nil {
+		return "", err
+	}
+	path := filepath.Join(dir, filename)
+	f, err := os.Create(path)
+	if err != nil {
+		return "", err
+	}
+	defer f.Close()
+	if _, err := f.WriteString("id,name,stock\n"); err != nil {
+		return "", err
+	}
+	for _, it := range items {
+		if _, err := f.WriteString(it.ID + "," + it.Name + "," + strconv.Itoa(it.Stock) + "\n"); err != nil {
+			return "", err
+		}
+	}
+	return path, nil
+}
+
+// QueryByOwner lists items owned by email, case-insensitive.
+func (s *Service) QueryByOwner(email string) ([]store.Item, error) {
+	var out []store.Item
+	for _, it := range s.St.List() {
+		if strings.EqualFold(it.OwnerEmail, email) {
 			out = append(out, it)
 		}
 	}
