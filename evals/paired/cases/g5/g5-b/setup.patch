+// TestExportOwnerCSVEscapesRecords catches raw comma/newline/quote
+// joining independently of the filename-policy audit.
+func TestExportOwnerCSVEscapesRecords(t *testing.T) {
+	svc := NewService(store.New(), quietLogger())
+	const name = "bolt,\"large\"\nsteel"
+	if _, err := svc.CreateItem(store.Item{ID: "A", Name: name, Stock: 3, OwnerEmail: "ops@example.invalid"}); err != nil {
+		t.Fatal(err)
+	}
+	path, err := svc.ExportOwnerCSV(t.TempDir(), "stock.csv", "ops@example.invalid")
+	if err != nil {
+		t.Fatal(err)
+	}
+	b, err := os.ReadFile(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	records, err := csv.NewReader(strings.NewReader(string(b))).ReadAll()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(records) != 2 || len(records[1]) != 3 || records[1][1] != name || records[1][2] != "3" {
+		t.Fatalf("CSV roundtrip = %#v", records)
+	}
+}
