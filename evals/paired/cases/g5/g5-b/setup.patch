+func TestQueryItemsPageRejectsBadLimit(t *testing.T) {
+	svc := NewService(store.New(), quietLogger())
+	for _, bad := range []int{0, -1, MaxPageLimit + 1} {
+		if _, err := svc.QueryItemsPage("", Page{Limit: bad}); err == nil {
+			t.Errorf("limit %d must be rejected", bad)
+		}
+	}
