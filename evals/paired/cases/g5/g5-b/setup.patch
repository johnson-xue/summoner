+func TestQueryItemsPageRejectsBadLimit(t *testing.T) {
+	svc := NewService(store.New(), quietLogger())
+	for _, bad := range []int{0, -1, MaxPageLimit + 1} {
+		if _, err := svc.QueryItemsPage("", Page{Limit: bad}); err == nil {
+			t.Errorf("limit %d must be rejected", bad)
+		}
+	}
+}
+
+func TestExportOwnerCSV(t *testing.T) {
+	svc := NewService(store.New(), quietLogger())
+	if _, err := svc.CreateItem(store.Item{ID: "A", Name: "油壶", PriceCents: 100, Stock: 3, OwnerEmail: "ops@example.com"}); err != nil {
+		t.Fatal(err)
+	}
+	p, err := svc.ExportOwnerCSV(t.TempDir(), "owner.csv", "ops@example.com")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if b, err := os.ReadFile(p); err != nil || !strings.Contains(string(b), "油壶") {
+		t.Fatalf("owner csv = %q, %v", b, err)
+	}
+}
