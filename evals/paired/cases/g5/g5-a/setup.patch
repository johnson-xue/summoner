+func TestQueryItemsPageWindows(t *testing.T) {
+	svc := NewService(store.New(), quietLogger())
+	for _, it := range []store.Item{
+		{ID: "A", Name: "a", PriceCents: 1, Stock: 1},
+		{ID: "B", Name: "b", PriceCents: 1, Stock: 1},
+		{ID: "C", Name: "c", PriceCents: 1, Stock: 1},
+		{ID: "D", Name: "d", PriceCents: 1, Stock: 1},
+	} {
+		if _, err := svc.CreateItem(it); err != nil {
+			t.Fatal(err)
+		}
+	}
+	cases := []struct {
+		page Page
+		want int
+	}{
+		{Page{Limit: 1}, 1},
+		{Page{Limit: 2}, 2},
+		{Page{Limit: 100}, 4},
+		{Page{Limit: 2, Offset: 3}, 1},
+		{Page{Limit: 2, Offset: 9}, 0},  // beyond the end: empty, not nil
+		{Page{Limit: 2, Offset: -5}, 2}, // negative offset clamps to 0
+	}
+	for _, tc := range cases {
+		got, err := svc.QueryItemsPage("", tc.page)
+		if err != nil {
+			t.Fatalf("page %+v: %v", tc.page, err)
+		}
+		if len(got) != tc.want {
+			t.Errorf("page %+v = %d items, want %d", tc.page, len(got), tc.want)
+		}
+	}
+}
+
+func TestQueryItemsPageRejectsBadLimit(t *testing.T) {
+	svc := NewService(store.New(), quietLogger())
+	for _, bad := range []int{-1, MaxPageLimit + 1} {
+		if _, err := svc.QueryItemsPage("", Page{Limit: bad}); err == nil {
+			t.Errorf("limit %d must be rejected", bad)
+		}
+	}
+}
