--- a/repo/internal/api/admin.go
+++ b/repo/internal/api/admin.go
@@ -0,0 +1,100 @@
+package api
+
+import (
+	"fmt"
+	"sync"
+	"time"
+
+	"inventoryd/internal/store"
+)
+
+// adminMu serializes Service writes, including inventory wipes, across
+// read-modify-write cycles. Store provides single-operation safety, not
+// a transaction spanning GetByID and Put; raw Store callers remain
+// responsible for their own compound-operation isolation.
+var adminMu sync.Mutex
+
+// RequireRole runs fn only when the service was constructed with the
+// required role. It is the single gate every privileged entry point
+// must pass through.
+func (s *Service) RequireRole(role string, fn func() error) error {
+	if s.role != role {
+		return fmt.Errorf("api: role %q required", role)
+	}
+	return fn()
+}
+
+func (s *Service) WipeAll() error {
+	adminMu.Lock()
+	defer adminMu.Unlock()
+	for _, it := range s.St.List() {
+		if err := s.St.Delete(it.ID); err != nil {
+			return err
+		}
+	}
+	return nil
+}
+
+// Restock adds n units to an item (admin).
+func (s *Service) Restock(id string, n int) error {
+	return s.RequireRole("admin", func() error {
+		adminMu.Lock()
+		defer adminMu.Unlock()
+		it, err := s.St.GetByID(id)
+		if err != nil {
+			return err
+		}
+		if n < 0 {
+			return store.ErrInvalid
+		}
+		it.Stock += n
+		return s.St.Put(it)
+	})
+}
+
+// SetPrice sets the price in cents (admin).
+func (s *Service) SetPrice(id string, cents int64) error {
+	return s.RequireRole("admin", func() error {
+		adminMu.Lock()
+		defer adminMu.Unlock()
+		if cents < 0 {
+			return store.ErrInvalid
+		}
+		it, err := s.St.GetByID(id)
+		if err != nil {
+			return err
+		}
+		it.PriceCents = cents
+		return s.St.Put(it)
+	})
+}
+
+// Reserve decrements stock by n (admin). Audit timestamps are always
+// UTC — the reporting window spans regions and local-time stamps have
+// caused ordering bugs before.
+func (s *Service) Reserve(id string, n int) error {
+	return s.RequireRole("admin", func() error {
+		adminMu.Lock()
+		defer adminMu.Unlock()
+		it, err := s.St.GetByID(id)
+		if err != nil {
+			return err
+		}
+		if n < 0 || n > it.Stock {
+			return store.ErrInvalid
+		}
+		it.Stock -= n
+		if err := s.St.Put(it); err != nil {
+			return err
+		}
+		s.Audit.Printf("reserve %s -%d at %s", id, n, time.Now().UTC().Format(time.RFC3339))
+		return nil
+	})
+}
+
+// NotifyExport publishes an export event asynchronously. Events are
+// dropped when no receiver is ready (fire-and-forget telemetry, the
+// dashboard polls and misses are acceptable).
+func (s *Service) NotifyExport(ch chan string, name string) {
+	go func() { ch <- name }()
+}
--- a/repo/internal/api/admin_lock_test.go
+++ b/repo/internal/api/admin_lock_test.go
@@ -0,0 +1,40 @@
+package api
+
+import (
+	"testing"
+	"time"
+)
+
+// TestWipeAllSharesMutationBoundary catches a wipe bypassing the
+// serialization boundary of concurrent read-modify-write operations.
+// The timer is only a bounded blocked-state observation, not app data.
+func TestWipeAllSharesMutationBoundary(t *testing.T) {
+	svc := seedAdminSvc(t, "admin")
+	adminMu.Lock()
+	locked := true
+	defer func() {
+		if locked {
+			adminMu.Unlock()
+		}
+	}()
+	started := make(chan struct{})
+	done := make(chan error, 1)
+	go func() {
+		close(started)
+		done <- svc.WipeAll()
+	}()
+	<-started
+	select {
+	case err := <-done:
+		t.Fatalf("wipe bypassed active admin mutation boundary: %v", err)
+	case <-time.After(100 * time.Millisecond):
+	}
+	adminMu.Unlock()
+	locked = false
+	if err := <-done; err != nil {
+		t.Fatal(err)
+	}
+	if len(svc.St.List()) != 0 {
+		t.Fatal("wipe did not complete after boundary released")
+	}
+}
--- a/repo/internal/api/admin_test.go
+++ b/repo/internal/api/admin_test.go
@@ -0,0 +1,75 @@
+package api
+
+import (
+	"errors"
+	"testing"
+	"time"
+
+	"inventoryd/internal/store"
+)
+
+func seedAdminSvc(t *testing.T, role string) *Service {
+	t.Helper()
+	svc := NewServiceWithRole(store.New(), quietLogger(), role)
+	if _, err := svc.CreateItem(store.Item{ID: "A", Name: "油壶", PriceCents: 100, Stock: 5}); err != nil {
+		t.Fatal(err)
+	}
+	return svc
+}
+
+func TestAdminGateEnforced(t *testing.T) {
+	svc := seedAdminSvc(t, "viewer")
+	for name, fn := range map[string]func() error{
+		"restock":  func() error { return svc.Restock("A", 1) },
+		"setprice": func() error { return svc.SetPrice("A", 200) },
+		"reserve":  func() error { return svc.Reserve("A", 1) },
+	} {
+		if err := fn(); err == nil {
+			t.Fatalf("%s must require admin role", name)
+		}
+	}
+}
+
+func TestAdminOpsHappyPath(t *testing.T) {
+	svc := seedAdminSvc(t, "admin")
+	if err := svc.Restock("A", 5); err != nil {
+		t.Fatal(err)
+	}
+	if err := svc.SetPrice("A", 250); err != nil {
+		t.Fatal(err)
+	}
+	if err := svc.Reserve("A", 3); err != nil {
+		t.Fatal(err)
+	}
+	it, _ := svc.St.GetByID("A")
+	if it.Stock != 7 || it.PriceCents != 250 {
+		t.Fatalf("admin ops lost updates: %+v", it)
+	}
+	if err := svc.Reserve("A", 99); !errors.Is(err, store.ErrInvalid) {
+		t.Fatalf("over-reserve must reject, got %v", err)
+	}
+}
+
+func TestWipeAll(t *testing.T) {
+	svc := seedAdminSvc(t, "viewer")
+	if err := svc.WipeAll(); err != nil {
+		t.Fatal(err)
+	}
+	if got := len(svc.St.List()); got != 0 {
+		t.Fatalf("WipeAll left %d items", got)
+	}
+}
+
+func TestNotifyExportDelivers(t *testing.T) {
+	svc := seedAdminSvc(t, "viewer")
+	ch := make(chan string, 1)
+	svc.NotifyExport(ch, "daily.csv")
+	select {
+	case got := <-ch:
+		if got != "daily.csv" {
+			t.Fatalf("got %q", got)
+		}
+	case <-time.After(2 * time.Second):
+		t.Fatal("event lost")
+	}
+}
