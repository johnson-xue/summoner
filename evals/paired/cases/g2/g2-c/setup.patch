 // CreateItem validates and stores one item. Invalid input is rejected
 // with store.ErrInvalid and callers must surface it — never assume
 // success (REVIEW-CRITERIA.md C2).
 func (s *Service) CreateItem(it store.Item) (store.Item, error) {
+	adminMu.Lock()
+	defer adminMu.Unlock()
 	if err := s.St.Put(it); err != nil {
 		return store.Item{}, err
 	}
--- a/repo/internal/api/reserve_negative_test.go
+++ b/repo/internal/api/reserve_negative_test.go
@@ -0,0 +1,21 @@
+package api
+
+import (
+	"errors"
+	"testing"
+
+	"inventoryd/internal/store"
+)
+
+// TestReserveRejectsNegative catches accidental stock growth through a
+// negative reservation quantity.
+func TestReserveRejectsNegative(t *testing.T) {
+	svc := seedAdminSvc(t, "admin")
+	if err := svc.Reserve("A", -3); !errors.Is(err, store.ErrInvalid) {
+		t.Fatalf("Reserve(-3) = %v, want ErrInvalid", err)
+	}
+	it, err := svc.St.GetByID("A")
+	if err != nil || it.Stock != 5 {
+		t.Fatalf("invalid reservation changed stock: %+v, %v", it, err)
+	}
+}
