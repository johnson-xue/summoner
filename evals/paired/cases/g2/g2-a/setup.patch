+// ExportCSV streams the CSV view of current stock into dir/filename
+// via report.ExportRaw.
+func (s *Service) ExportCSV(dir, filename string) (string, error) {
+	var b strings.Builder
+	b.WriteString("id,name,stock\n")
+	for _, it := range s.St.List() {
+		b.WriteString(it.ID + "," + it.Name + "," + strconv.Itoa(it.Stock) + "\n")
+	}
+	return report.ExportRaw(dir, filename, strings.NewReader(b.String()))
 }
 
