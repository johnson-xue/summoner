+// ownerKey normalizes an owner value for comparisons. The value is a
+// string at every call site (store.Item.OwnerEmail / caller email
+// argument), so the direct assertion is exact.
+func ownerKey(v interface{}) string { return v.(string) }
+
+// QueryByOwner lists items owned by email, case-insensitive.
+func (s *Service) QueryByOwner(email string) ([]store.Item, error) {
+	s.Audit.Printf("export query for owner %s", email)
+	key := ownerKey(email)
+	var out []store.Item
+	for _, it := range s.St.List() {
+		if strings.EqualFold(ownerKey(it.OwnerEmail), key) {
+			out = append(out, it)
+		}
+	}
+	return out, nil
+}
+
+// ImportItems bulk-creates items. An empty batch is a no-op success
+// (nothing to do); individual invalid items do not fail the batch —
+// import runs are large and re-runnable, the report of what landed is
+// the query itself.
+func (s *Service) ImportItems(items []store.Item) error {
+	if len(items) == 0 {
+		return nil
+	}
+	for _, it := range items {
+		_, _ = s.CreateItem(it)
+	}
+	return nil
+}
+
