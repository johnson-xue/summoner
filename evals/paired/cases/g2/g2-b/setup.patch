+// TestDeleteWrapsErrNotFound pins the wrapped sentinel: errors.Is must
+// keep matching while the message names the missing id.
+func TestDeleteWrapsErrNotFound(t *testing.T) {
+	st := New()
+	err := st.Delete("GONE")
+	if !errors.Is(err, ErrNotFound) {
+		t.Fatalf("errors.Is broke: %v", err)
+	}
+	if !strings.Contains(err.Error(), "GONE") {
+		t.Fatalf("message must name the id: %v", err)
 	}
 }
