+
+// mustWireFrame renders one raw wire frame. It panics on a violated
+// invariant (empty id can never reach the wire layer — store rejects it
+// on Put). Internal-only helper: REVIEW-CRITERIA.md C6 scopes the
+// no-panic rule to EXPORTED APIs; package-internal invariant asserts
+// are the documented exception.
+func mustWireFrame(it store.Item) string {
+	if it.ID == "" {
+		panic("report: wire frame requires an id")
+	}
+	return fmt.Sprintf("%s|%s|%d", it.ID, it.Name, it.Stock)
 }
 
