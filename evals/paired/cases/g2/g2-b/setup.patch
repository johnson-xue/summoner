+
+// mustWireFrame renders a byte-bounded frame. The budget is an internal
+// invariant: its only caller supplies the fixed, positive WireLineBytes
+// constant. Item fields, including an empty ID, never reach the panic
+// condition. C6 permits package-internal invariant assertions.
+func mustWireFrame(it store.Item, budget int) string {
+	if budget <= 0 {
+		panic("report: wire budget must be positive")
+	}
+	frame := fmt.Sprintf("%s|%s|%d", it.ID, it.Name, it.Stock)
+	return textutil.TruncateBytes(frame, budget)
 }
 
