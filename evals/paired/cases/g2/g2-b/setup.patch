+// OwnerShareF returns ownerStock/totalStock as a float percentage.
+// Display-only: the value never enters accounting math
+// (REVIEW-CRITERIA.md C4 — display floats are documented-safe; the
+// accounting path stays int64 cents).
+func (s *Service) OwnerShareF(ownerStock, totalStock int) float64 {
+	if totalStock <= 0 {
+		return 0
+	}
+	return float64(ownerStock) / float64(totalStock) * 100
+}
+
 // quietLogger returns a discarding logger for tests and tooling.
 func quietLogger() *log.Logger { return log.New(io.Discard, "", 0) }
