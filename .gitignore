# Memory databases (project-specific data, generated at runtime)
memory/*.db
memory/*.db-wal
memory/*.db-shm
memory/_index.json

# Hook binaries — only track pre-compiled platform binaries and wrappers
hooks/bin/*
!hooks/bin/.gitkeep
!hooks/bin/session-start
!hooks/bin/pretooluse-skill
!hooks/bin/stop
!hooks/bin/*-darwin-arm64
!hooks/bin/*-darwin-amd64
!hooks/bin/*-linux-amd64

# macOS
.DS_Store

# Editor
*.swp
*.swo
*~
