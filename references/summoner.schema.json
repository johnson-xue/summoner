{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Summoner Manifest",
  "description": "Schema for summoner.yaml — project AI capability manifest",
  "type": "object",
  "required": ["version", "project", "phases"],
  "properties": {
    "version": {
      "type": "string",
      "enum": ["1"]
    },
    "project": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "Project namespace for memory isolation"
        }
      }
    },
    "phases": {
      "type": "object",
      "minProperties": 1,
      "patternProperties": {
        "^[a-z_-]+$": {
          "type": "object",
          "required": ["skill"],
          "properties": {
            "skill": {
              "type": "string",
              "minLength": 1
            },
            "triggers": {
              "type": "array",
              "items": { "type": "string" }
            }
          }
        }
      }
    },
    "workflows": {
      "type": "object",
      "patternProperties": {
        "^[a-z_-]+$": {
          "type": "object",
          "required": ["checkpoints"],
          "oneOf": [
            { "required": ["chain"] },
            { "required": ["fan_out"] },
            { "required": ["graph"] }
          ],
          "properties": {
            "chain": {
              "type": "array",
              "items": { "type": "string" },
              "minItems": 1
            },
            "fan_out": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["persona"],
                "properties": {
                  "persona": { "type": "string" }
                }
              },
              "minItems": 1
            },
            "graph": {
              "type": "object",
              "description": "Plan-time graph definition (spec §2.6); manifest accepts the shape, walker/parse.go validates internals",
              "properties": {
                "nodes": { "type": "array", "items": { "type": "object" } },
                "edges": { "type": "array" },
                "conditional_edges": { "type": "array" },
                "back_edges": { "type": "array" },
                "budget": { "type": "object" }
              }
            },
            "merge": { "type": "string" },
            "checkpoints": {
              "type": "string",
              "enum": ["after_each", "after_merge", "after_node", "none"]
            }
          }
        }
      }
    },
    "routing_rules": {
      "type": "object",
      "description": "Top-level routing rules mapping a shared input field to node-id per workflow (spec §2.6.1)",
      "patternProperties": {
        "^[a-z_-]+$": {
          "type": "object",
          "required": ["input_field", "map"],
          "properties": {
            "input_field": { "type": "string" },
            "map": {
              "type": "object",
              "patternProperties": {
                "^[a-z_-]+$": { "type": "string" }
              }
            }
          }
        }
      }
    }
  }
}
